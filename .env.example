# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=corpor43_crm
DB_USER=corpor43_corper
DB_PASS=Per43-crm
DB_CHARSET=utf8mb4

# Application Settings
APP_NAME=Corporate Setup CRM
APP_VERSION=1.0.0
APP_URL=https://corporate-setup.com
APP_DEBUG=false
APP_ENV=production

# Security Settings
HASH_ALGO=PASSWORD_ARGON2ID
SESSION_TIMEOUT=1800
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# File Upload Settings
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif

# Date/Time Settings
DATE_FORMAT=d-m-Y
DATETIME_FORMAT=d-m-Y H:i:s
TIMEZONE=Africa/Lagos

# Email Settings (for notifications)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@corporate-setup.com
MAIL_FROM_NAME=Corporate Setup CRM

# Logging
LOG_LEVEL=warning
LOG_FILE=logs/app.log

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL=3600

# API Settings
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=3600
